/* 组件样式与页面隔离，这里直接写色值（与 app.wxss 的变量保持一致） */
.tabbar { position:fixed; left:0; right:0; bottom:0; z-index:99; height:calc(112rpx + env(safe-area-inset-bottom)); padding:0 12rpx env(safe-area-inset-bottom); box-sizing:border-box; display:flex; align-items:stretch; background:#FFFDF9; border-top:1rpx solid #EFE7DB; box-shadow:0 -6rpx 24rpx rgba(92,68,40,.04); }
.tab { flex:1; min-width:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6rpx; color:#9A8E82; }
.icon { width:48rpx; height:48rpx; }
.label { font-size:22rpx; line-height:1.2; white-space:nowrap; }
.tab.active { color:#E06C3E; }
.tab.active .label { font-weight:600; }

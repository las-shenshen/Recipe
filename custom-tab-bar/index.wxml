<view wx:if="{{!hidden}}" class="tabbar">
  <view wx:for="{{list}}" wx:key="pagePath" class="tab {{selected === index ? 'active' : ''}}" data-index="{{index}}" bindtap="switchTab">
    <!-- 两种颜色的图标都先渲染好，切换时只改显示，避免换图闪烁 -->
    <image class="icon" hidden="{{selected === index}}" src="/assets/tabbar/{{item.icon}}.svg" mode="aspectFit" />
    <image class="icon" hidden="{{selected !== index}}" src="/assets/tabbar/{{item.icon}}-active.svg" mode="aspectFit" />
    <text class="label">{{item.text}}</text>
  </view>
</view>

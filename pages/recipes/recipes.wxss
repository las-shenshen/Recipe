.page { min-height:100vh; box-sizing:border-box; padding:32rpx 32rpx calc(var(--tabbar-space) + 48rpx); }
.heading { display:flex; align-items:center; justify-content:space-between; margin-top:8rpx; }
.title { font-family:var(--serif); font-size:48rpx; line-height:1.3; font-weight:700; }
.add { flex:none; padding:16rpx 28rpx; border-radius:999rpx; background:var(--accent); color:#FFF; font-size:26rpx; font-weight:600; }

.search { height:88rpx; margin-top:28rpx; padding:0 28rpx; display:flex; align-items:center; gap:16rpx; border-radius:var(--radius-control); background:var(--fill); color:var(--ink-3); }
.search input { flex:1; min-width:0; height:88rpx; color:var(--ink); font-size:28rpx; }
.cloud-hint { margin-top:16rpx; color:var(--ink-3); font-size:24rpx; }
.cloud-hint.warning { color:var(--accent-deep); }

/* 分类 */
.category-heading { display:flex; align-items:center; justify-content:space-between; margin-top:36rpx; font-size:30rpx; font-weight:600; }
.category-tools { display:flex; gap:12rpx; }
.category-tool { padding:10rpx 22rpx; border-radius:999rpx; background:var(--fill); color:var(--ink-2); font-size:24rpx; font-weight:400; }
.category-tool.add-category { background:var(--accent-soft); color:var(--accent-deep); }
.category-scroll { margin:20rpx -32rpx 0; white-space:nowrap; }
.category-tabs { display:inline-flex; gap:16rpx; padding:0 32rpx; }
.category-chip { flex:none; display:flex; align-items:center; gap:10rpx; padding:14rpx 32rpx; border:2rpx solid var(--line); border-radius:999rpx; color:var(--ink-2); font-size:26rpx; }
.category-chip.selected { border-color:var(--green-soft); background:var(--green-soft); color:var(--green); font-weight:600; }
.category-chip.managing { border-style:dashed; }
.category-remove { width:36rpx; height:36rpx; margin-right:-14rpx; border-radius:50%; background:var(--accent); color:#FFF; text-align:center; line-height:32rpx; font-size:28rpx; font-weight:400; }

/* 菜谱卡片：左滑露出操作按钮 */
.list-hint { margin-top:32rpx; color:var(--ink-3); font-size:24rpx; }
.list { display:flex; flex-direction:column; gap:20rpx; margin-top:20rpx; }
.swipe-shell { position:relative; overflow:hidden; border:1rpx solid var(--line); border-radius:28rpx; box-shadow:var(--shadow-card); }
.swipe-actions { position:absolute; top:0; right:0; bottom:0; width:240rpx; display:flex; align-items:stretch; }
.swipe-actions view { width:120rpx; display:flex; align-items:center; justify-content:center; color:#FFF; font-size:26rpx; font-weight:600; }
.swipe-actions.single-action view { width:240rpx; }
.swipe-edit { background:#BE8A52; }
.swipe-delete { background:var(--accent); }
.swipe-favorite { background:var(--green-solid); }
.row { position:relative; z-index:1; display:flex; align-items:center; gap:24rpx; width:100%; box-sizing:border-box; padding:24rpx; background:var(--card); transition:transform .22s ease; }
.swipe-shell.opened .row { transform:translateX(-240rpx); }
.art { flex:none; width:120rpx; height:120rpx; display:flex; align-items:center; justify-content:center; border-radius:28rpx; font-size:64rpx; line-height:1; }
.info { flex:1; min-width:0; display:flex; flex-direction:column; gap:6rpx; }
.name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:32rpx; line-height:1.3; font-weight:600; }
.caption { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--ink-3); font-size:24rpx; }
.author-line { display:flex; align-items:center; gap:8rpx; margin-top:4rpx; color:var(--ink-3); font-size:22rpx; }
.author-avatar { flex:none; width:32rpx; height:32rpx; border-radius:50%; }
.avatar-fallback { background:var(--fill); text-align:center; line-height:32rpx; font-size:18rpx; }
.chevron { flex:none; width:16rpx; height:16rpx; margin-right:8rpx; box-sizing:border-box; border-top:4rpx solid var(--ink-4); border-right:4rpx solid var(--ink-4); transform:rotate(45deg); }

.empty { display:flex; flex-direction:column; align-items:center; gap:16rpx; padding:72rpx 16rpx; color:var(--ink-3); font-size:28rpx; text-align:center; }
.empty-icon { font-size:80rpx; line-height:1.2; }
.note { margin:48rpx 0 0; color:var(--ink-3); font-size:24rpx; text-align:center; }

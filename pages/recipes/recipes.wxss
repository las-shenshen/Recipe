.page { padding:36rpx 36rpx 150rpx; background:#FFFCF7; min-height:100vh; box-sizing:border-box; }.eyebrow { color:#A18C77; font-size:18rpx; letter-spacing:3rpx; }.heading { display:flex; justify-content:space-between; align-items:center; margin-top:12rpx; }.title { font-family:serif; font-size:42rpx; font-weight:700; }.add { padding:13rpx 19rpx; background:#F3E8DA; color:#AD6B43; border-radius:30rpx; font-size:21rpx; }.search { margin-top:27rpx; height:77rpx; border:2rpx solid #EEE5D8; border-radius:22rpx; display:flex; align-items:center; gap:15rpx; padding:0 22rpx; color:#987D69; }.search text { font-size:37rpx; }.search input { flex:1; font-size:23rpx; }.cloud-hint { margin-top:14rpx; color:#8E7D6D; font-size:19rpx; }.cloud-hint.warning { color:#C77855; }.category-heading { margin-top:21rpx; display:flex; align-items:center; justify-content:space-between; color:#51493F; font-size:22rpx; font-weight:600; }.category-tools { display:flex; gap:12rpx; }.category-tool { color:#9A806B; background:#F5EEE5; border-radius:24rpx; padding:9rpx 16rpx; font-size:18rpx; font-weight:400; }.category-tool.add-category { color:#A95F3B; background:#F4E6D8; }.category-scroll { margin-top:12rpx; white-space:nowrap; width:100%; }.category-tabs { display:flex; gap:14rpx; padding:2rpx 0 5rpx; }.category-chip { flex-shrink:0; display:flex; align-items:center; gap:7rpx; padding:15rpx 24rpx; border:1rpx solid #EEE5D8; border-radius:32rpx; color:#8D7867; background:#FFFCF7; font-size:21rpx; }.category-chip.selected { border-color:#E8EDE2; color:#657154; background:#E8EDE2; }.category-chip.managing { border-style:dashed; }.category-remove { width:27rpx; height:27rpx; line-height:24rpx; text-align:center; border-radius:50%; color:#fff; background:#D8754C; font-size:24rpx; }.list { margin-top:19rpx; }.swipe-shell { position:relative; overflow:hidden; border-bottom:1rpx solid #EDE5D9; }.swipe-actions { position:absolute; top:0; right:0; bottom:0; width:220rpx; display:flex; align-items:stretch; }.swipe-actions view { width:110rpx; display:flex; align-items:center; justify-content:center; color:white; font-size:22rpx; }.swipe-actions.single-action view { width:220rpx; }.swipe-edit { background:#D4A16F; }.swipe-delete { background:#D8754C; }.swipe-favorite { background:#8A9B75; }.row { position:relative; z-index:1; box-sizing:border-box; width:100%; min-height:155rpx; display:flex; align-items:center; gap:20rpx; background:#FFFCF7; transition:transform .22s ease; }.swipe-shell.opened .row { transform:translateX(-220rpx); }.art { width:93rpx; height:93rpx; border-radius:22rpx; display:flex; align-items:center; justify-content:center; font-size:48rpx; flex-shrink:0; }.info { flex:1; display:flex; flex-direction:column; gap:7rpx; min-width:0; }.name { font-size:27rpx; font-weight:650; }.author-line { display:flex; align-items:center; gap:7rpx; color:#958575; font-size:18rpx; }.author-avatar { width:27rpx; height:27rpx; border-radius:50%; flex-shrink:0; }.avatar-fallback { display:flex; align-items:center; justify-content:center; background:#F4EBDD; font-size:16rpx; }.caption { font-size:19rpx; color:#97877A; }.time { color:#8D7867; font-size:20rpx; white-space:nowrap; }.empty { padding:55rpx 10rpx; text-align:center; color:#A99A8C; font-size:22rpx; }.note { text-align:center; margin:40rpx 0; color:#A99A8C; font-size:20rpx; }

.page { padding-bottom:40rpx; }.cover { height:430rpx;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center; }.food { font-size:190rpx;z-index:1;filter:drop-shadow(0 18rpx 14rpx #55452b33); }.plate { position:absolute;width:350rpx;height:350rpx;border-radius:50%;border:18rpx solid #fff9; }.cover-label { position:absolute;bottom:25rpx;left:36rpx;color:#746C5F;font-size:21rpx; }.content { padding:0 36rpx; }.title-row { display:flex;justify-content:space-between;align-items:flex-start;margin-top:32rpx; }.title-row>view:first-child { display:flex;flex-direction:column; }.title { font-family:serif;font-size:43rpx;font-weight:700; }.desc { color:#928C81;font-size:23rpx;line-height:1.7;margin-top:12rpx; }.favorite { width:65rpx;height:65rpx;border-radius:50%;background:#F7F2EB;text-align:center;line-height:65rpx;font-size:39rpx;color:#989084;flex-shrink:0; }.favorite.on { color:#E5764A;background:#F9EAE1; }.facts { display:flex;justify-content:space-around;background:#F7F4ED;border-radius:18rpx;padding:22rpx 8rpx;margin-top:30rpx;color:#766F63;font-size:21rpx; }.facts view { display:flex;align-items:center;gap:10rpx; }.fact-icon { color:#DE8059;font-size:27rpx; }.section { margin-top:39rpx; }.section-title { font-size:30rpx;font-weight:700;margin-bottom:19rpx; }.section-title text { color:#B3AA9B;font-size:19rpx;font-weight:400;margin-left:10rpx; }.ingredient { padding:19rpx 4rpx;border-bottom:1rpx solid #F0EDE6;display:flex;justify-content:space-between;font-size:24rpx; }.ingredient-name { color:#47443E; }.amount { color:#9D968B; }.add-list { margin-top:19rpx;text-align:center;padding:18rpx;border-radius:14rpx;background:#F9EEE7;color:#D8754C;font-size:22rpx; }.step { display:flex;gap:17rpx;margin:24rpx 0;align-items:flex-start;font-size:24rpx;line-height:1.75;color:#57534B; }.step-no { width:43rpx;height:43rpx;border-radius:50%;background:#F8E9DD;color:#D9774E;line-height:43rpx;text-align:center;font-weight:700;flex-shrink:0; }.endnote { text-align:center;margin:48rpx 0 10rpx;color:#B4AC9F;font-size:20rpx; }.endnote text { color:#DE8059; }
.set-picker { display:flex; justify-content:space-between; align-items:center; margin-top:25rpx; padding:19rpx 4rpx; border-top:1rpx solid #F0EDE6; }
.set-copy { display:flex; flex-direction:column; gap:6rpx; font-size:22rpx; font-weight:600; color:#4C4942; }
.set-copy text+text { color:#A29A8D; font-size:18rpx; font-weight:400; }
.stepper { display:flex; align-items:center; gap:20rpx; color:#514B42; font-size:24rpx; }
.step-button { width:54rpx; height:54rpx; border-radius:50%; display:flex; justify-content:center; align-items:center; background:#F6EEE4; color:#D8754C; font-size:30rpx; }
.author-row { display:flex; align-items:center; gap:9rpx; margin-top:15rpx; color:#958575; font-size:20rpx; }
.author-avatar { width:34rpx; height:34rpx; border-radius:50%; flex-shrink:0; }
.author-fallback { display:flex; align-items:center; justify-content:center; background:#F4EBDD; font-size:20rpx; }

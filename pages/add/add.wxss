.page { padding:34rpx 36rpx 50rpx; }.intro { display:flex;flex-direction:column;margin:10rpx 0 30rpx; }.eyebrow { font-size:17rpx;letter-spacing:3rpx;color:#B4A78F; }.title { font-family:serif;font-size:41rpx;font-weight:700;margin-top:12rpx; }.title text { color:#E5764A; }.subtitle { color:#918B80;font-size:22rpx;margin-top:10rpx; }.form-card { border-radius:22rpx;background:white;padding:4rpx 26rpx;box-shadow:0 8rpx 30rpx #5848270c; }.field { padding:25rpx 0;border-bottom:1rpx solid #F1EEE8; }.field:last-child { border-bottom:0; }.label { display:block;font-size:22rpx;font-weight:650;margin-bottom:15rpx; }.label text { color:#E5764A; }.field input,.field textarea,.picker-value { font-size:24rpx;color:#4C4942; }.field input { height:45rpx; }.field textarea { width:100%;min-height:52rpx; }.picker-value { display:flex;justify-content:space-between;color:#777166; }.picker-value text { color:#B4A999; }.row { display:flex;gap:28rpx; }.half { flex:1; }.label-row { display:flex;justify-content:space-between;align-items:center; }.inline-action { font-size:21rpx;color:#D8754C; }.ingredient-row { display:flex;align-items:center;gap:12rpx;margin-top:15rpx;padding:12rpx 14rpx;background:#FAF8F3;border-radius:12rpx; }.ingredient-row input:first-child { flex:1.4; }.ingredient-row input:nth-child(2) { flex:1; }.remove { width:36rpx;text-align:center;color:#B7AFA2;font-size:31rpx; }.step-row { display:flex;gap:14rpx;align-items:flex-start;margin-top:17rpx;padding:13rpx;background:#FAF8F3;border-radius:12rpx; }.step-index { width:34rpx;height:34rpx;border-radius:50%;background:#F6E8DD;color:#D8754C;text-align:center;line-height:34rpx;font-size:19rpx; }.step-row textarea { flex:1;min-height:45rpx;font-size:22rpx; }.save { margin-top:30rpx;height:88rpx;line-height:88rpx;background:#E5764A;color:white;border-radius:16rpx;font-size:27rpx;font-weight:600; }.save text { margin-left:10rpx; }.footnote { text-align:center;margin-top:19rpx;color:#B4ADA1;font-size:18rpx; }
.save { display:flex; align-items:center; justify-content:center; text-align:center; }

.page { padding:32rpx 32rpx calc(64rpx + env(safe-area-inset-bottom)); }
.intro { display:flex; flex-direction:column; margin-bottom:32rpx; }
.title { margin-top:8rpx; font-family:var(--serif); font-size:46rpx; line-height:1.35; font-weight:700; }
.title text { color:var(--accent); }
.subtitle { margin-top:8rpx; color:var(--ink-3); font-size:26rpx; }

.form-card { padding:12rpx 28rpx; border:1rpx solid var(--line); border-radius:var(--radius-card); background:var(--card); box-shadow:var(--shadow-card); }
.field { padding:20rpx 0; }
.label { display:block; margin-bottom:16rpx; font-size:28rpx; font-weight:600; }
.label text { color:var(--accent); }
.label-row { display:flex; align-items:center; justify-content:space-between; }
.label-row .label { margin-bottom:0; }
.inline-action { padding:8rpx 0 8rpx 16rpx; color:var(--accent); font-size:26rpx; font-weight:600; }
.row { display:flex; gap:24rpx; }
.half { flex:1; min-width:0; }

/* 输入控件 */
.text-input { height:88rpx; padding:0 24rpx; box-sizing:border-box; border-radius:20rpx; background:var(--fill); color:var(--ink); font-size:28rpx; }
.picker-value { height:88rpx; padding:0 28rpx 0 24rpx; box-sizing:border-box; display:flex; align-items:center; justify-content:space-between; border-radius:20rpx; background:var(--fill); color:var(--ink); font-size:28rpx; }
.picker-value .icon-chevron-down { color:var(--ink-3); }
.switch-value { height:88rpx; padding:0 12rpx 0 24rpx; box-sizing:border-box; display:flex; align-items:center; justify-content:space-between; border-radius:20rpx; background:var(--fill); color:var(--ink); font-size:28rpx; }
.switch-value switch { transform:scale(.8); transform-origin:right center; }
.textarea-box { padding:22rpx 24rpx; border-radius:20rpx; background:var(--fill); }
.textarea-box textarea, .step-row textarea { width:100%; min-height:44rpx; color:var(--ink); font-size:28rpx; line-height:1.5; }

.ingredient-row { display:flex; align-items:center; gap:12rpx; margin-top:16rpx; }
.ingredient-row .text-input { flex:1.4; min-width:0; }
.ingredient-row .amount-input { flex:1; }
.step-row { display:flex; align-items:flex-start; gap:16rpx; margin-top:16rpx; padding:22rpx 12rpx 22rpx 20rpx; border-radius:20rpx; background:var(--fill); }
.step-row textarea { flex:1; width:auto; min-width:0; }
.step-index { flex:none; width:44rpx; height:44rpx; border-radius:50%; background:var(--accent-soft); color:var(--accent-deep); text-align:center; line-height:44rpx; font-size:24rpx; font-weight:600; }
.remove { flex:none; width:56rpx; height:56rpx; text-align:center; line-height:52rpx; color:var(--ink-4); font-size:40rpx; }
.step-row .remove { margin-top:-6rpx; }

.save { height:96rpx; margin-top:40rpx; padding:0; display:flex; align-items:center; justify-content:center; border-radius:var(--radius-control); background:var(--accent); color:#FFF; font-size:32rpx; font-weight:600; line-height:96rpx; box-shadow:0 12rpx 28rpx rgba(224,108,62,.24); }
.footnote { margin-top:24rpx; color:var(--ink-3); font-size:24rpx; text-align:center; }

<view class="page">
  <view class="page-heading">
    <view class="brand-line"><view class="brand-mark">家</view><text class="brand-name">家的味道</text></view>
    <text class="page-title">{{loggedIn ? '我的厨房' : '个人中心'}}</text>
    <text class="page-subtitle">{{loggedIn ? '把喜欢的味道，慢慢收进生活里。' : '登录后同步你的菜谱与收藏。'}}</text>
  </view>

  <view wx:if="{{!loggedIn}}" class="welcome-panel">
    <view class="welcome-art">
      <view class="art-leaf leaf-left">✳</view>
      <view class="art-plate"><view class="plate-center">家</view><view class="plate-leaf">✦</view></view>
      <view class="art-leaf leaf-right">✿</view>
    </view>
    <text class="welcome-title">让每一餐，都有家的味道</text>
    <text class="welcome-copy">用微信快速登录，跨设备同步你的菜谱和收藏</text>
    <button class="wechat-login" loading="{{loading}}" disabled="{{loading}}" bindtap="login">
      <view class="wechat-mark"><view></view><view></view></view>
      <text>{{loading ? '正在安全连接微信…' : '微信一键登录'}}</text>
    </button>
    <text class="privacy-copy">登录即表示使用微信身份识别，不会公开你的微信号</text>
  </view>

  <view wx:else class="account-panel">
    <view class="account-topline"><text class="eyebrow">MY ACCOUNT</text><view class="connected"><view class="connected-dot"></view>微信已连接</view></view>
    <view class="account-main">
      <button wx:if="{{editing}}" class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" aria-label="更换头像">
        <image wx:if="{{avatarTempPath || (profile.avatarUrl && !avatarBroken)}}" class="avatar" src="{{avatarTempPath || profile.avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
        <view wx:else class="avatar avatar-placeholder">家</view>
        <view class="avatar-edit">✎</view>
      </button>
      <image wx:elif="{{profile.avatarUrl && !avatarBroken}}" class="avatar" src="{{profile.avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
      <view wx:else class="avatar avatar-placeholder">家</view>
      <view class="account-copy">
        <input wx:if="{{editing}}" class="nickname-input" type="nickname" value="{{nicknameInput}}" maxlength="30" placeholder="输入你的昵称" bindinput="onNicknameInput" />
        <text wx:else class="account-name">{{profile.nickname || '微信用户'}}</text>
        <text class="account-hint">{{editing ? '点头像更换 · 昵称最多 30 字' : '微信账号 · 菜谱和收藏已同步'}}</text>
      </view>
      <button wx:if="{{!editing}}" class="edit-button" bindtap="editProfile" aria-label="编辑个人资料">✎</button>
    </view>
    <view wx:if="{{editing}}" class="edit-actions">
      <button class="cancel-button" bindtap="cancelEdit">取消</button>
      <button class="save-button" loading="{{loading}}" disabled="{{loading}}" bindtap="saveProfile">保存资料</button>
    </view>
  </view>

  <view class="section-title"><text>厨房里的日常</text><text class="section-note">一触即达</text></view>
  <view class="shortcut-list">
    <view class="shortcut-row" bindtap="goFavorites"><view class="shortcut-icon favorites-icon">♡</view><view class="shortcut-copy"><text class="shortcut-name">我的收藏</text><text class="shortcut-detail">常做的菜，随时找得到</text></view><text class="shortcut-arrow">›</text></view>
    <view class="shortcut-row" bindtap="goRecipes"><view class="shortcut-icon recipes-icon">▤</view><view class="shortcut-copy"><text class="shortcut-name">家庭菜谱</text><text class="shortcut-detail">看看今天有什么灵感</text></view><text class="shortcut-arrow">›</text></view>
    <view class="shortcut-row" bindtap="goMenu"><view class="shortcut-icon menu-icon">♨</view><view class="shortcut-copy"><text class="shortcut-name">一周点菜</text><text class="shortcut-detail">和家人一起安排三餐</text></view><text class="shortcut-arrow">›</text></view>
    <view class="shortcut-row" bindtap="goShopping"><view class="shortcut-icon shopping-icon">☷</view><view class="shortcut-copy"><text class="shortcut-name">买菜清单</text><text class="shortcut-detail">采购要买的食材</text></view><text class="shortcut-arrow">›</text></view>
  </view>

  <button wx:if="{{loggedIn}}" class="logout-button" bindtap="logout">退出微信登录</button>
</view>

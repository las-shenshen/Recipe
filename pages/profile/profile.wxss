.page { min-height:100vh; box-sizing:border-box; padding:18rpx 36rpx 72rpx; background:#F7F5EF; color:#302D27; }
.page-heading { padding:18rpx 2rpx 27rpx; }
.brand-line { display:flex; align-items:center; gap:12rpx; }
.brand-mark { width:46rpx; height:46rpx; display:flex; align-items:center; justify-content:center; border-radius:15rpx; background:#D96C4B; color:#FFFDF8; font-family:serif; font-size:25rpx; font-weight:700; }
.brand-name { color:#655B4C; font-family:serif; font-size:21rpx; font-weight:600; }
.page-title { display:block; margin-top:28rpx; color:#342F29; font-family:serif; font-size:42rpx; font-weight:700; }
.page-subtitle { display:block; margin-top:8rpx; color:#8E877B; font-size:21rpx; }
.welcome-panel { display:flex; flex-direction:column; align-items:center; padding:34rpx 27rpx 27rpx; border:1rpx solid #ECE7DD; border-radius:25rpx; background:#FFFDF8; }
.welcome-art { position:relative; width:260rpx; height:208rpx; display:flex; align-items:center; justify-content:center; }
.art-plate { width:176rpx; height:176rpx; display:flex; align-items:center; justify-content:center; border:10rpx solid #E8E0D2; border-radius:50%; background:#FBF8F0; box-shadow:inset 0 0 0 7rpx #FFFDF8,0 9rpx 24rpx rgba(73,59,42,.07); }
.plate-center { width:107rpx; height:107rpx; display:flex; align-items:center; justify-content:center; border:2rpx solid #DDE3D0; border-radius:50%; background:#E9EEDF; color:#748367; font-family:serif; font-size:45rpx; font-weight:700; }
.plate-leaf { position:absolute; right:38rpx; bottom:32rpx; color:#DB825D; font-size:31rpx; }
.art-leaf { position:absolute; color:#95A27F; }
.leaf-left { left:6rpx; top:39rpx; font-size:37rpx; transform:rotate(-18deg); }
.leaf-right { right:2rpx; top:35rpx; color:#D99969; font-size:44rpx; transform:rotate(12deg); }
.welcome-title { margin-top:14rpx; color:#3B342C; font-family:serif; font-size:27rpx; font-weight:700; text-align:center; }
.welcome-copy { margin-top:10rpx; color:#968A7C; font-size:19rpx; line-height:1.6; text-align:center; }
.wechat-login { width:100%; height:86rpx; display:flex; align-items:center; justify-content:center; gap:13rpx; margin:31rpx 0 0; padding:0; border:0; border-radius:17rpx; background:#537D5B; color:#FFFDF8; font-size:22rpx; font-weight:600; line-height:86rpx; }
.wechat-login::after,.avatar-button::after,.edit-button::after,.cancel-button::after,.save-button::after,.logout-button::after { border:0; }
.wechat-mark { position:relative; width:37rpx; height:29rpx; }
.wechat-mark view:first-child { position:absolute; left:0; top:1rpx; width:25rpx; height:19rpx; border-radius:50%; background:#FFFDF8; }
.wechat-mark view:first-child::after { position:absolute; right:2rpx; bottom:-3rpx; width:6rpx; height:6rpx; background:#FFFDF8; content:""; transform:rotate(35deg); }
.wechat-mark view:last-child { position:absolute; right:0; bottom:0; width:19rpx; height:15rpx; border:2rpx solid #537D5B; border-radius:50%; background:#E8F1E5; }
.privacy-copy { margin-top:18rpx; color:#A69C8E; font-size:16rpx; text-align:center; }
.account-panel { padding:25rpx 26rpx 23rpx; border:1rpx solid #ECE7DD; border-radius:25rpx; background:#FFFDF8; }
.account-topline { display:flex; align-items:center; justify-content:space-between; }
.eyebrow { color:#A59681; font-size:15rpx; }
.connected { display:flex; align-items:center; gap:8rpx; color:#728269; font-size:16rpx; }
.connected-dot { width:11rpx; height:11rpx; border-radius:50%; background:#82976E; }
.account-main { display:flex; align-items:center; gap:20rpx; margin-top:21rpx; }
.avatar { width:112rpx; height:112rpx; flex:none; border:4rpx solid #F2EDE3; border-radius:50%; background:#EBEFE2; }
.avatar-placeholder { display:flex; align-items:center; justify-content:center; color:#7A896A; font-family:serif; font-size:41rpx; }
.avatar-button { position:relative; width:120rpx !important; min-width:120rpx; max-width:120rpx; height:120rpx !important; min-height:120rpx; max-height:120rpx; display:flex; flex:none; align-items:center; justify-content:center; margin:0; padding:0; border:0; border-radius:50%; background:transparent; line-height:normal; }
.avatar-edit { position:absolute; right:0; bottom:2rpx; width:34rpx; height:34rpx; display:flex; align-items:center; justify-content:center; border:3rpx solid #FFFDF8; border-radius:50%; background:#D96C4B; color:#FFF; font-size:19rpx; }
.account-copy { min-width:0; flex:1; display:flex; flex-direction:column; gap:9rpx; }
.account-name { overflow:hidden; color:#3B342D; font-family:serif; font-size:27rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }
.account-hint { color:#958A7D; font-size:17rpx; }
.nickname-input { width:100%; height:43rpx; color:#38332C; font-size:24rpx; line-height:43rpx; }
.nickname-input::placeholder { color:#AAA092; }
.edit-button { width:58rpx !important; min-width:58rpx; max-width:58rpx; height:58rpx !important; min-height:58rpx; max-height:58rpx; flex:0 0 58rpx; display:flex; align-items:center; justify-content:center; margin:0 0 0 auto; padding:0; border:1rpx solid #E8E1D5; border-radius:17rpx; background:#FBF8F1; color:#887966; font-size:25rpx; line-height:1; white-space:nowrap; }
.edit-actions { display:flex; gap:13rpx; margin-top:20rpx; }
.cancel-button,.save-button { height:70rpx; display:flex; flex:1; align-items:center; justify-content:center; margin:0; padding:0; border:1rpx solid #E8E1D5; border-radius:15rpx; background:#FFFDF8; color:#796C5E; font-size:19rpx; line-height:70rpx; }
.save-button { border-color:#537D5B; background:#537D5B; color:#FFFDF8; }
.section-title { display:flex; align-items:baseline; justify-content:space-between; margin:31rpx 3rpx 13rpx; }
.section-title text:first-child { color:#403930; font-family:serif; font-size:23rpx; font-weight:700; }
.section-note { color:#A3998C; font-size:16rpx; }
.shortcut-list { overflow:hidden; border:1rpx solid #ECE7DD; border-radius:22rpx; background:#FFFDF8; }
.shortcut-row { min-height:109rpx; box-sizing:border-box; display:flex; align-items:center; gap:17rpx; padding:15rpx 21rpx; border-bottom:1rpx solid #F0ECE4; }
.shortcut-row:last-child { border-bottom:0; }
.shortcut-icon { width:66rpx; height:66rpx; flex:none; display:flex; align-items:center; justify-content:center; border-radius:20rpx; font-size:34rpx; }
.favorites-icon { background:#F4E8E1; color:#C77868; }
.recipes-icon { background:#F3EBDD; color:#B18A54; }
.menu-icon { background:#E9EEDF; color:#758765; }
.shopping-icon { background:#E9EEF0; color:#6F8790; }
.shortcut-copy { min-width:0; flex:1; display:flex; flex-direction:column; gap:6rpx; }
.shortcut-name { color:#463D33; font-size:20rpx; font-weight:600; }
.shortcut-detail { color:#A1988C; font-size:16rpx; }
.shortcut-arrow { color:#B4AA9D; font-family:serif; font-size:34rpx; }
.logout-button { width:100%; height:76rpx; margin:22rpx 0 0; padding:0; border:1rpx solid #E7DED2; border-radius:15rpx; background:transparent; color:#9A7060; font-size:19rpx; line-height:76rpx; }

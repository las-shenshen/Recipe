.page { padding:0 36rpx 145rpx; min-height:100vh; background:#FFFCF7; color:#2B2824; box-sizing:border-box; }
.date-line { color:#968577; font-size:22rpx; letter-spacing:1rpx; }
.topline { display:flex; align-items:center; justify-content:space-between; margin-top:11rpx; }
.headline { font-family:serif; font-size:45rpx; line-height:1.3; font-weight:700; letter-spacing:1rpx; }
.home-badge { max-width:235rpx; height:62rpx; padding:0 15rpx 0 5rpx; box-sizing:border-box; border-radius:36rpx; background:#F0DDC8; display:flex; align-items:center; gap:9rpx; }.home-badge image { width:52rpx; height:52rpx; border-radius:50%; flex-shrink:0; }.home-badge-icon { width:52rpx; height:52rpx; border-radius:50%; background:#F8ECDE; display:flex; align-items:center; justify-content:center; font-size:30rpx; flex-shrink:0; }.home-badge-label { max-width:150rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#805F47; font-size:17rpx; }
.search { margin-top:34rpx; height:78rpx; border:2rpx solid #EEE5D8; border-radius:23rpx; display:flex; align-items:center; padding:0 22rpx; gap:15rpx; background:#FFFCF7; }
.search-icon { font-size:36rpx; color:#987D69; }.search input { flex:1; font-size:23rpx; }.clear { font-size:34rpx; color:#9b9287; }
.hero { margin-top:29rpx; height:275rpx; border-radius:29rpx; background:linear-gradient(135deg,#F1DDC6,#EAC6A1); position:relative; overflow:hidden; padding:31rpx 29rpx; box-sizing:border-box; display:flex; }
.hero-copy { display:flex; flex-direction:column; z-index:1; }.hero-tag { font-size:21rpx; color:#805B3F; }.hero-title { width:390rpx; margin-top:18rpx; font-family:serif; font-size:38rpx; font-weight:700; }.hero-subtitle { margin-top:4rpx; font-family:serif; font-size:36rpx; font-weight:700; }.hero-cta { margin-top:22rpx; padding:12rpx 21rpx; border-radius:35rpx; background:#FFFCF7; color:#775B47; font-size:21rpx; align-self:flex-start; }.hero-cta text { margin-left:15rpx; }
.hero-dish { position:absolute; right:25rpx; top:76rpx; width:118rpx; height:118rpx; border-radius:50%; display:flex; justify-content:center; align-items:center; background:#F7EBD9; box-shadow:0 12rpx 25rpx #78563a2b; }.hero-dish text { font-size:76rpx; }
.section-head { display:flex; align-items:center; justify-content:space-between; margin-top:37rpx; }.section-title { font-family:serif; font-size:30rpx; font-weight:700; }.section-link { color:#8E7D6D; font-size:21rpx; }.section-link text { margin-left:6rpx; }.category-scroll { margin:23rpx -36rpx 0; white-space:nowrap; }.categories { display:inline-flex; gap:15rpx; padding:0 36rpx; }.category { border:2rpx solid #EEE5D8; border-radius:40rpx; padding:15rpx 24rpx; color:#8E7D6D; font-size:22rpx; background:#FFFCF7; }.category.active { border-color:#E9EEE4; background:#E9EEE4; color:#657458; }
.recipe-heading { margin-top:43rpx; margin-bottom:14rpx; }.recipe-list { display:flex; flex-direction:column; }.recipe-row { min-height:135rpx; display:flex; align-items:center; gap:19rpx; border-bottom:1rpx solid #EDE5D9; position:relative; }.recipe-art { width:93rpx; height:93rpx; border-radius:23rpx; display:flex; align-items:center; justify-content:center; flex-shrink:0; }.recipe-art text { font-size:48rpx; }.recipe-info { flex:1; display:flex; flex-direction:column; gap:10rpx; min-width:0; }.recipe-name { font-size:27rpx; font-weight:650; }.recipe-caption { font-size:20rpx; color:#97877A; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:350rpx; }.recipe-time { color:#8D7867; font-size:21rpx; white-space:nowrap; }.heart { position:absolute; top:15rpx; left:0; width:42rpx; height:42rpx; border-radius:50%; text-align:center; line-height:42rpx; color:#E5764A; font-size:24rpx; background:#FFFCF7CC; }.empty { display:flex; flex-direction:column; align-items:center; gap:20rpx; padding:65rpx 0; color:#97877A; font-size:23rpx; }.empty view { color:#D67149; }
.recipe-author { display:flex; align-items:center; gap:7rpx; color:#958575; font-size:17rpx; }.recipe-author image,.author-fallback { width:26rpx; height:26rpx; border-radius:50%; flex-shrink:0; }.author-fallback { display:flex; align-items:center; justify-content:center; background:#F4EBDD; font-size:15rpx; }

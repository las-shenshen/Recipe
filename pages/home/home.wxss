.page { min-height:100vh; box-sizing:border-box; padding:0 32rpx calc(var(--tabbar-space) + 48rpx); }

/* 顶部：日期行与右上角胶囊按钮同高，标题行落在胶囊下方 */
.date-line { height:64rpx; line-height:64rpx; color:var(--ink-3); font-size:24rpx; letter-spacing:2rpx; }
.topline { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin-top:12rpx; }
.headline { font-family:var(--serif); font-size:50rpx; line-height:1.3; font-weight:700; letter-spacing:1rpx; }
.home-badge { flex:none; max-width:260rpx; height:68rpx; padding:0 22rpx 0 8rpx; box-sizing:border-box; display:flex; align-items:center; gap:10rpx; border-radius:999rpx; background:var(--accent-soft); }
.home-badge image, .home-badge-icon { flex:none; width:52rpx; height:52rpx; border-radius:50%; }
.home-badge-icon { background:var(--card); text-align:center; line-height:52rpx; font-size:28rpx; }
.home-badge-label { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--accent-deep); font-size:24rpx; }

.search { height:88rpx; margin-top:32rpx; padding:0 28rpx; display:flex; align-items:center; gap:16rpx; border-radius:var(--radius-control); background:var(--fill); color:var(--ink-3); }
.search input { flex:1; min-width:0; height:88rpx; color:var(--ink); font-size:28rpx; }
.clear { flex:none; width:56rpx; height:56rpx; margin-right:-12rpx; text-align:center; line-height:52rpx; font-size:40rpx; }

/* 推荐卡片 */
.hero { position:relative; overflow:hidden; display:flex; margin-top:32rpx; padding:36rpx 32rpx; box-sizing:border-box; border-radius:var(--radius-card); background:linear-gradient(135deg,#F7E4CD,#EBC49C); }
.hero::before { content:""; position:absolute; right:-80rpx; top:-90rpx; width:380rpx; height:380rpx; border-radius:50%; background:rgba(255,252,247,.26); }
.hero-copy { position:relative; z-index:1; display:flex; flex-direction:column; align-items:flex-start; width:420rpx; }
.hero-tag { padding:6rpx 20rpx; border-radius:999rpx; background:rgba(255,252,247,.62); color:#7A5536; font-size:22rpx; }
.hero-title { display:-webkit-box; overflow:hidden; -webkit-box-orient:vertical; -webkit-line-clamp:2; margin-top:22rpx; color:#3A2B1E; font-family:var(--serif); font-size:46rpx; line-height:1.25; font-weight:700; }
.hero-subtitle { margin-top:10rpx; color:#7A5536; font-size:26rpx; }
.hero-cta { margin-top:28rpx; padding:14rpx 28rpx; border-radius:999rpx; background:var(--paper); color:#6B4A30; font-size:26rpx; font-weight:600; }
.hero-cta text { margin-left:12rpx; }
.hero-dish { position:absolute; right:36rpx; top:50%; width:176rpx; height:176rpx; margin-top:-88rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:rgba(255,252,247,.78); box-shadow:0 16rpx 32rpx rgba(120,86,58,.18); }
.hero-dish text { font-size:104rpx; line-height:1; }

.section-head { display:flex; align-items:baseline; justify-content:space-between; margin-top:48rpx; }
.section-title { font-family:var(--serif); font-size:36rpx; font-weight:700; }
.section-link { padding:8rpx 0 8rpx 16rpx; color:var(--ink-3); font-size:24rpx; }
.section-link text { margin-left:4rpx; }

.category-scroll { margin:24rpx -32rpx 0; white-space:nowrap; }
.categories { display:inline-flex; gap:16rpx; padding:0 32rpx; }
.category { padding:14rpx 32rpx; border:2rpx solid var(--line); border-radius:999rpx; color:var(--ink-2); font-size:26rpx; }
.category.active { border-color:var(--green-soft); background:var(--green-soft); color:var(--green); font-weight:600; }

/* 菜谱卡片 */
.recipe-heading { margin-bottom:24rpx; }
.recipe-list { display:flex; flex-direction:column; gap:20rpx; }
.recipe-row { display:flex; align-items:center; gap:24rpx; padding:24rpx; border:1rpx solid var(--line); border-radius:28rpx; background:var(--card); box-shadow:var(--shadow-card); }
.recipe-art { flex:none; width:120rpx; height:120rpx; display:flex; align-items:center; justify-content:center; border-radius:28rpx; }
.recipe-art text { font-size:64rpx; line-height:1; }
.recipe-info { flex:1; min-width:0; display:flex; flex-direction:column; gap:6rpx; }
.recipe-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:32rpx; line-height:1.3; font-weight:600; }
.recipe-caption { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--ink-3); font-size:24rpx; }
.recipe-meta { display:flex; align-items:center; gap:8rpx; margin-top:4rpx; color:var(--ink-3); font-size:22rpx; }
.recipe-meta image, .author-fallback { flex:none; width:32rpx; height:32rpx; border-radius:50%; }
.author-fallback { background:var(--fill); text-align:center; line-height:32rpx; font-size:18rpx; }
.author-name { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.recipe-time { flex:none; }
.heart { flex:none; width:72rpx; height:72rpx; margin-right:-8rpx; text-align:center; line-height:72rpx; color:var(--ink-4); font-size:40rpx; }
.heart.liked { color:var(--accent); }

.empty { display:flex; flex-direction:column; align-items:center; gap:16rpx; padding:72rpx 0; color:var(--ink-3); font-size:28rpx; }
.empty-icon { font-size:80rpx; line-height:1.2; }
.empty-action { padding:12rpx 24rpx; color:var(--accent); font-size:28rpx; font-weight:600; }

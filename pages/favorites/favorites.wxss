.page { min-height:100vh; box-sizing:border-box; padding:32rpx 32rpx calc(var(--tabbar-space) + 48rpx); }
.title { margin-top:8rpx; font-family:var(--serif); font-size:48rpx; line-height:1.3; font-weight:700; }
.title text { color:var(--accent); }
.cloud-hint { margin-top:16rpx; color:var(--ink-3); font-size:24rpx; }
.cloud-hint.warning { color:var(--accent-deep); }

/* 分段切换 */
.mode-tabs { display:flex; gap:8rpx; margin-top:28rpx; padding:8rpx; border-radius:var(--radius-control); background:var(--fill); }
.mode-tab { flex:1; padding:16rpx 8rpx; border-radius:18rpx; color:var(--ink-3); text-align:center; font-size:26rpx; }
.mode-tab.active { background:var(--card); color:var(--accent-deep); font-weight:600; box-shadow:0 4rpx 12rpx rgba(92,68,40,.08); }

.list { display:flex; flex-direction:column; gap:20rpx; margin-top:28rpx; }
.row { display:flex; align-items:flex-start; gap:24rpx; padding:24rpx; border:1rpx solid var(--line); border-radius:28rpx; background:var(--card); box-shadow:var(--shadow-card); }
.art { flex:none; width:120rpx; height:120rpx; display:flex; align-items:center; justify-content:center; border-radius:28rpx; font-size:64rpx; line-height:1; }
.info { flex:1; min-width:0; display:flex; flex-direction:column; gap:8rpx; }
.name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:32rpx; line-height:1.3; font-weight:600; }
.caption { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--ink-3); font-size:24rpx; }
.person-line, .collector { display:flex; align-items:center; gap:8rpx; color:var(--ink-3); font-size:22rpx; }
.avatar { flex:none; width:32rpx; height:32rpx; border-radius:50%; }
.fallback { background:var(--fill); color:var(--accent); text-align:center; line-height:32rpx; font-size:18rpx; }
.collectors { display:flex; align-items:center; flex-wrap:wrap; gap:8rpx 12rpx; margin-top:4rpx; }
.collector { padding:4rpx 16rpx 4rpx 6rpx; border-radius:999rpx; background:var(--accent-soft); color:var(--accent-deep); }
.count { color:var(--ink-3); font-size:22rpx; }
.favorite-action { flex:none; width:72rpx; height:72rpx; margin:24rpx -8rpx 0 0; text-align:center; line-height:72rpx; color:var(--ink-4); font-size:40rpx; }
.favorite-action.liked { color:var(--accent); }

.empty { display:flex; flex-direction:column; align-items:center; gap:16rpx; padding:120rpx 0; color:var(--ink-3); font-size:28rpx; }
.empty-heart { color:var(--accent); font-size:88rpx; line-height:1.2; }
.empty-action { padding:12rpx 24rpx; color:var(--accent); font-size:28rpx; font-weight:600; }

.page { padding:36rpx 36rpx 150rpx; background:#FFFCF7; min-height:100vh; box-sizing:border-box; }.eyebrow { color:#A18C77; font-size:18rpx; letter-spacing:3rpx; }.title { margin-top:12rpx; font-family:serif; font-size:42rpx; font-weight:700; }.title text { color:#D97952; }.cloud-hint { margin-top:14rpx; color:#8E7D6D; font-size:19rpx; }.cloud-hint.warning { color:#C77855; }.mode-tabs { display:flex; gap:14rpx; margin-top:25rpx; }.mode-tab { padding:14rpx 24rpx; border:1rpx solid #EEE5D8; border-radius:30rpx; color:#8D7867; font-size:21rpx; }.mode-tab.active { border-color:#F4E4D6; background:#F4E4D6; color:#B76D49; }.list { margin-top:20rpx; }.row { min-height:150rpx; display:flex; align-items:center; gap:18rpx; padding:18rpx 0; border-bottom:1rpx solid #EDE5D9; }.art { width:88rpx; height:88rpx; border-radius:22rpx; display:flex; align-items:center; justify-content:center; font-size:45rpx; flex-shrink:0; }.info { flex:1; min-width:0; display:flex; flex-direction:column; gap:9rpx; }.name { font-size:26rpx; font-weight:650; }.person-line,.collector { display:flex; align-items:center; gap:7rpx; color:#958575; font-size:18rpx; }.avatar { width:28rpx; height:28rpx; border-radius:50%; flex-shrink:0; }.fallback { display:flex; align-items:center; justify-content:center; background:#F4EBDD; font-size:15rpx; }.collectors { display:flex; align-items:center; gap:10rpx; flex-wrap:wrap; }.count { color:#A99A8C; font-size:17rpx; }.caption { color:#97877A; font-size:19rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }.favorite-action { width:54rpx; height:54rpx; line-height:54rpx; text-align:center; color:#D97952; font-size:34rpx; flex-shrink:0; }.empty { display:flex; align-items:center; flex-direction:column; gap:18rpx; padding:105rpx 0; color:#97877A; font-size:23rpx; }.empty-heart { font-size:70rpx; color:#D97952; }.empty view { color:#D67149; }

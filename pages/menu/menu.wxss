.page { min-height:100vh; box-sizing:border-box; padding:32rpx 32rpx calc(var(--tabbar-space) + 48rpx); }
.heading { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin-top:8rpx; }
.heading-copy { min-width:0; display:flex; flex-direction:column; }
.title { font-family:var(--serif); font-size:48rpx; line-height:1.3; font-weight:700; }
.subtitle { margin-top:6rpx; color:var(--ink-3); font-size:26rpx; }
.planned-badge { flex:none; padding:12rpx 26rpx; border-radius:999rpx; background:var(--accent-soft); color:var(--accent-deep); font-size:26rpx; font-weight:600; }

/* 同步状态与旧安排导入 */
.sync-status { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:28rpx; padding:20rpx 24rpx; border-radius:20rpx; background:var(--green-soft); color:var(--green); font-size:24rpx; }
.sync-status.sync-error { background:#FBE9E3; color:#A5472F; }
.sync-action { flex:none; font-weight:600; }
.legacy-import { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:16rpx; padding:20rpx 24rpx; border:1rpx solid #EBD9C3; border-radius:20rpx; background:#FFF8EE; }
.legacy-title { color:var(--accent-deep); font-size:26rpx; font-weight:600; }
.legacy-detail { color:var(--ink-3); font-size:24rpx; }

/* 分段切换 */
.mode-switch { display:flex; gap:8rpx; margin-top:28rpx; padding:8rpx; border-radius:var(--radius-control); background:var(--fill); }
.mode-option { flex:1; padding:16rpx 8rpx; border-radius:18rpx; color:var(--ink-3); text-align:center; font-size:26rpx; }
.mode-option.mode-active { background:var(--card); color:var(--accent-deep); font-weight:600; box-shadow:0 4rpx 12rpx rgba(92,68,40,.08); }
.mode-option text { margin-left:6rpx; color:var(--accent); }

/* 日期选择 */
.date-card { display:flex; align-items:center; justify-content:space-between; margin-top:28rpx; padding:20rpx 24rpx; border:1rpx solid var(--line); border-radius:28rpx; background:var(--card); box-shadow:var(--shadow-card); }
.date-arrow { position:relative; flex:none; width:72rpx; height:72rpx; border-radius:50%; background:var(--fill); }
.date-arrow::after { content:""; position:absolute; left:50%; top:50%; width:16rpx; height:16rpx; margin:-10rpx 0 0 -10rpx; border-top:4rpx solid var(--ink-2); border-right:4rpx solid var(--ink-2); }
.arrow-prev::after { margin-left:-6rpx; transform:rotate(-135deg); }
.arrow-next::after { margin-left:-14rpx; transform:rotate(45deg); }
.date-center { display:flex; flex-direction:column; align-items:center; gap:4rpx; padding:0 24rpx; }
.date-main { font-size:32rpx; font-weight:600; }
.date-value { display:flex; align-items:center; gap:8rpx; color:var(--ink-3); font-size:24rpx; }
.week-navigation { display:flex; align-items:center; justify-content:space-between; margin-top:28rpx; color:var(--ink-2); font-size:28rpx; font-weight:600; }
.week-strip { width:100%; margin-top:20rpx; white-space:nowrap; }
.week-days { display:flex; justify-content:space-between; gap:10rpx; padding:2rpx 0 6rpx; }
.week-day { position:relative; flex:1; min-width:80rpx; height:116rpx; box-sizing:border-box; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4rpx; border:2rpx solid var(--line); border-radius:24rpx; background:var(--card); color:var(--ink-3); }
.week-day-selected { border-color:var(--green-solid); background:var(--green-soft); color:var(--green); }
.weekday-text { font-size:22rpx; }
.week-day-number { font-size:32rpx; line-height:1.2; font-weight:600; }
.eaten-dot { position:absolute; right:12rpx; top:12rpx; width:12rpx; height:12rpx; border-radius:50%; background:var(--accent); }

/* 三餐卡片 */
.intro-row { display:flex; align-items:center; justify-content:space-between; margin:40rpx 4rpx 4rpx; font-size:32rpx; font-weight:600; }
.clear-link { padding:8rpx 0 8rpx 16rpx; color:var(--accent-deep); font-size:26rpx; font-weight:400; }
.meal-card { margin-top:20rpx; padding:28rpx; border:1rpx solid var(--line); border-radius:28rpx; background:var(--card); box-shadow:var(--shadow-card); }
.meal-head { display:flex; align-items:center; gap:20rpx; }
.meal-icon { flex:none; width:80rpx; height:80rpx; display:flex; align-items:center; justify-content:center; border-radius:24rpx; background:var(--accent-soft); font-size:40rpx; line-height:1; }
.meal-title-wrap { flex:1; min-width:0; display:flex; flex-direction:column; gap:2rpx; }
.meal-title { font-size:32rpx; font-weight:600; }
.meal-subtitle { color:var(--ink-3); font-size:24rpx; }
.meal-count { flex:none; color:var(--ink-3); font-size:26rpx; }
.meal-empty { padding:28rpx 0 20rpx; color:var(--ink-3); font-size:26rpx; }
.dish-list { margin-top:20rpx; }
.dish-row { display:flex; align-items:center; gap:12rpx; padding:18rpx 0; border-top:1rpx solid var(--line); }
.dish-main { flex:1; min-width:0; display:flex; align-items:center; gap:20rpx; }
.dish-art { flex:none; width:88rpx; height:88rpx; display:flex; align-items:center; justify-content:center; border-radius:22rpx; font-size:46rpx; line-height:1; }
.dish-info { flex:1; min-width:0; display:flex; flex-direction:column; gap:4rpx; }
.dish-name { display:flex; align-items:baseline; gap:8rpx; font-size:30rpx; font-weight:600; }
.dish-name-text { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.dish-quantity { flex:none; color:var(--accent); font-size:26rpx; }
.dish-meta { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--ink-3); font-size:24rpx; }
.eaten-toggle { flex:none; padding:10rpx 22rpx; border:2rpx solid var(--line); border-radius:999rpx; color:var(--ink-2); font-size:24rpx; }
.eaten-toggle.is-eaten { border-color:var(--green-soft); background:var(--green-soft); color:var(--green); font-weight:600; }
.remove-dish { flex:none; width:64rpx; height:64rpx; margin-right:-16rpx; text-align:center; line-height:60rpx; color:var(--ink-4); font-size:40rpx; }
.add-dish { margin-top:4rpx; padding:24rpx 0 0; border-top:2rpx dashed var(--line); color:var(--accent-deep); text-align:center; font-size:28rpx; font-weight:600; }
.shopping-cta { margin-top:32rpx; padding:28rpx 24rpx; border-radius:var(--radius-control); background:var(--accent); color:#FFF; text-align:center; font-size:30rpx; font-weight:600; box-shadow:0 12rpx 28rpx rgba(224,108,62,.24); }
.footnote { margin-top:24rpx; color:var(--ink-3); text-align:center; font-size:24rpx; }

/* 本周回顾 */
.weekly-summary { display:flex; align-items:center; gap:28rpx; margin-top:28rpx; padding:28rpx 32rpx; border-radius:var(--radius-card); background:linear-gradient(135deg,#F9EFE0,#F3E3CE); }
.summary-number { flex:none; color:var(--accent); font-family:var(--serif); font-size:64rpx; line-height:1.1; font-weight:700; }
.summary-copy { min-width:0; display:flex; flex-direction:column; gap:4rpx; }
.summary-title { font-size:30rpx; font-weight:600; }
.summary-caption { color:var(--ink-2); font-size:24rpx; }
.history-list { margin-top:8rpx; }
.history-day { margin-top:20rpx; padding:28rpx; border:1rpx solid var(--line); border-radius:28rpx; background:var(--card); box-shadow:var(--shadow-card); }
.history-date { display:flex; align-items:baseline; justify-content:space-between; padding-bottom:20rpx; border-bottom:1rpx solid var(--line); font-size:30rpx; font-weight:600; }
.history-count { color:var(--ink-3); font-size:24rpx; font-weight:400; }
.history-meal { margin-top:20rpx; }
.history-meal-title { display:flex; align-items:center; gap:10rpx; margin-bottom:8rpx; color:var(--ink-2); font-size:26rpx; }
.history-dish { display:flex; align-items:center; gap:20rpx; padding:12rpx 0; }
.history-art { flex:none; width:76rpx; height:76rpx; display:flex; align-items:center; justify-content:center; border-radius:20rpx; font-size:40rpx; line-height:1; }
.history-dish-info { flex:1; min-width:0; display:flex; flex-direction:column; gap:2rpx; }
.history-dish-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:28rpx; }
.history-dish-meta { color:var(--ink-3); font-size:24rpx; }
.history-check { flex:none; padding:6rpx 18rpx; border-radius:999rpx; background:var(--green-soft); color:var(--green); font-size:22rpx; }
.history-empty { display:flex; flex-direction:column; align-items:center; gap:12rpx; margin-top:40rpx; padding:56rpx 32rpx; border:2rpx dashed var(--line); border-radius:28rpx; color:var(--ink-2); font-size:28rpx; text-align:center; }
.history-empty-icon { font-size:80rpx; line-height:1.2; }
.history-empty-hint { color:var(--ink-3); font-size:24rpx; }

/* 选菜面板 */
.picker-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:120; display:flex; align-items:flex-end; background:rgba(31,27,23,.42); }
.picker-panel { width:100%; max-height:calc(100vh - env(safe-area-inset-top)); box-sizing:border-box; display:flex; flex-direction:column; overflow:hidden; padding:28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius:40rpx 40rpx 0 0; background:var(--paper); }
.picker-drag-area { flex:none; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8rpx; height:64rpx; margin-top:-12rpx; padding-bottom:12rpx; color:var(--ink-4); font-size:22rpx; }
.picker-drag-bar { width:72rpx; height:8rpx; border-radius:8rpx; background:#D8CCBE; }
.picker-head { flex:none; display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.picker-head-copy { min-width:0; display:flex; flex-direction:column; gap:4rpx; }
.picker-title { font-family:var(--serif); font-size:38rpx; font-weight:700; }
.picker-hint { color:var(--ink-3); font-size:24rpx; }
.picker-close { flex:none; width:64rpx; height:64rpx; border-radius:50%; background:var(--fill); color:var(--ink-2); text-align:center; line-height:60rpx; font-size:40rpx; }
.picker-search { flex:none; display:flex; align-items:center; gap:16rpx; height:84rpx; margin-top:24rpx; padding:0 28rpx; border-radius:var(--radius-control); background:var(--fill); color:var(--ink-3); }
.picker-search input { flex:1; min-width:0; height:84rpx; color:var(--ink); font-size:28rpx; }
.picker-list { flex:1; min-height:0; height:0; margin-top:16rpx; }
.picker-recipe { display:flex; align-items:center; gap:20rpx; padding:18rpx 12rpx; border-bottom:1rpx solid var(--line); }
.picker-recipe-selected { border-radius:22rpx; border-bottom-color:transparent; background:var(--accent-soft); }
.picker-art { flex:none; width:88rpx; height:88rpx; display:flex; align-items:center; justify-content:center; border-radius:22rpx; font-size:46rpx; line-height:1; }
.picker-recipe-info { flex:1; min-width:0; display:flex; flex-direction:column; gap:4rpx; }
.picker-recipe-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:30rpx; font-weight:600; }
.picker-recipe-meta { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--ink-3); font-size:24rpx; }
.picker-actions { flex:none; display:flex; align-items:center; gap:10rpx; }
.picker-stepper { width:60rpx; height:60rpx; box-sizing:border-box; border:2rpx solid #E6D3C2; border-radius:50%; background:var(--card); color:var(--accent-deep); text-align:center; line-height:54rpx; font-size:34rpx; }
.picker-selected-count { color:var(--accent-deep); font-size:24rpx; white-space:nowrap; }
.picker-add { height:60rpx; padding:0 24rpx; border-radius:999rpx; background:var(--accent-soft); color:var(--accent-deep); line-height:60rpx; font-size:26rpx; font-weight:600; white-space:nowrap; }
.picker-add-more { width:60rpx; padding:0; background:var(--accent); color:#FFF; text-align:center; font-size:34rpx; line-height:56rpx; }
.picker-add:active { opacity:.7; }
.picker-empty { padding:64rpx 0; color:var(--ink-3); text-align:center; font-size:28rpx; }

.page { min-height:100vh; box-sizing:border-box; padding:36rpx 36rpx 160rpx; background:#FFFCF7; }
.eyebrow { color:#A18C77; font-size:18rpx; letter-spacing:3rpx; }
.heading { display:flex; align-items:center; justify-content:space-between; margin-top:12rpx; }
.title { display:block; font-family:serif; font-size:42rpx; font-weight:700; color:#342F29; }
.subtitle { display:block; margin-top:7rpx; color:#A19384; font-size:20rpx; }
.sync-status { display:flex; justify-content:space-between; margin-top:22rpx; padding:14rpx 20rpx; border-radius:16rpx; background:#EEF1E8; color:#677454; font-size:20rpx; }
.sync-error { background:#FFF0E7; color:#B66B45; }
.legacy-import { display:flex; justify-content:space-between; margin-top:16rpx; color:#A86643; font-size:20rpx; }
.legacy-import text { color:#A19384; font-size:18rpx; }
.planned-badge { padding:12rpx 20rpx; border-radius:30rpx; background:#F4E8D9; color:#A86643; font-size:20rpx; }
.date-card { display:flex; align-items:center; justify-content:space-between; margin-top:30rpx; padding:18rpx 22rpx; border:1rpx solid #EEE5D8; border-radius:24rpx; background:#FFFDF9; }
.date-arrow { width:54rpx; height:54rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:#F6F0E8; color:#9A7D65; font-size:40rpx; line-height:1; }
.date-center { display:flex; flex-direction:column; align-items:center; gap:5rpx; }
.date-main { color:#3D352E; font-size:25rpx; font-weight:600; }
.date-value { color:#A18C77; font-size:18rpx; }
.intro-row { display:flex; align-items:center; justify-content:space-between; margin:31rpx 2rpx 15rpx; color:#3D352E; font-size:24rpx; font-weight:600; }
.clear-link { color:#BD7552; font-size:19rpx; font-weight:400; }
.meal-card { margin-top:16rpx; padding:22rpx; border:1rpx solid #F0E8DC; border-radius:24rpx; background:#FFFDF9; box-shadow:0 7rpx 22rpx rgba(89,67,42,.035); }
.meal-head { display:flex; align-items:center; }
.meal-icon { width:65rpx; height:65rpx; display:flex; align-items:center; justify-content:center; border-radius:20rpx; background:#F5EBDD; font-size:32rpx; }
.meal-title-wrap { display:flex; flex:1; flex-direction:column; gap:5rpx; margin-left:16rpx; }
.meal-title { color:#3D352E; font-size:26rpx; font-weight:650; }
.meal-subtitle { color:#A19384; font-size:17rpx; }
.meal-count { color:#A18C77; font-size:18rpx; }
.meal-empty { padding:23rpx 0 17rpx; color:#B0A497; font-size:20rpx; }
.dish-list { margin-top:11rpx; }
.dish-row { display:flex; align-items:center; justify-content:space-between; padding:13rpx 0; border-top:1rpx solid #F1EBE2; }
.dish-main { display:flex; align-items:center; flex:1; min-width:0; }
.dish-art { width:68rpx; height:68rpx; display:flex; align-items:center; justify-content:center; border-radius:18rpx; font-size:36rpx; flex-shrink:0; }
.dish-info { display:flex; flex-direction:column; gap:6rpx; margin-left:15rpx; min-width:0; }
.dish-name { color:#453C33; font-size:22rpx; font-weight:600; }
.dish-meta { color:#A19384; font-size:17rpx; }
.remove-dish { width:52rpx; height:52rpx; display:flex; align-items:center; justify-content:center; color:#B6A99B; font-size:33rpx; }
.add-dish { margin-top:8rpx; padding:15rpx 0 3rpx; border-top:1rpx dashed #E9DFD1; color:#B36C48; text-align:center; font-size:20rpx; }
.shopping-cta { margin-top:25rpx; padding:22rpx 20rpx; border-radius:22rpx; background:#F6E8DC; color:#A95F3B; text-align:center; font-size:22rpx; font-weight:600; }
.footnote { margin:20rpx 0 0; color:#B2A697; text-align:center; font-size:17rpx; }
.picker-mask { position:fixed; inset:0; z-index:120; display:flex; align-items:flex-end; background:rgba(31,27,23,.42); }
.picker-panel { width:100%; max-height:78vh; box-sizing:border-box; padding:28rpx 34rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius:30rpx 30rpx 0 0; background:#FFFCF7; }
.picker-head { display:flex; align-items:center; justify-content:space-between; }
.picker-head view { display:flex; flex-direction:column; gap:6rpx; }
.picker-title { color:#3D352E; font-family:serif; font-size:29rpx; font-weight:700; }
.picker-hint { color:#A19384; font-size:18rpx; }
.picker-close { width:48rpx; height:48rpx; border-radius:50%; background:#F4EEE6; color:#8E7D6D; text-align:center; line-height:46rpx; font-size:32rpx; }
.picker-search { display:flex; align-items:center; gap:14rpx; height:72rpx; margin-top:21rpx; padding:0 20rpx; border:1rpx solid #EEE5D8; border-radius:19rpx; color:#987D69; }
.picker-search text { font-size:34rpx; }
.picker-search input { flex:1; font-size:21rpx; }
.picker-list { max-height:54vh; margin-top:12rpx; }
.picker-recipe { display:flex; align-items:center; padding:15rpx 2rpx; border-bottom:1rpx solid #F0E8DC; }
.picker-art { width:66rpx; height:66rpx; display:flex; align-items:center; justify-content:center; border-radius:17rpx; font-size:34rpx; }
.picker-recipe-info { display:flex; flex:1; flex-direction:column; gap:6rpx; margin-left:15rpx; }
.picker-recipe-name { color:#453C33; font-size:22rpx; font-weight:600; }
.picker-recipe-meta { color:#A19384; font-size:17rpx; }
.picker-add { color:#C77953; font-size:30rpx; }
.picker-empty { padding:50rpx 0; color:#A99A8C; text-align:center; font-size:21rpx; }
.mode-switch { display:flex; gap:8rpx; margin-top:24rpx; padding:7rpx; border-radius:20rpx; background:#F4EEE6; }
.mode-option { flex:1; padding:14rpx 8rpx; border-radius:15rpx; color:#958575; text-align:center; font-size:20rpx; }
.mode-option.mode-active { background:#FFFDF9; color:#A95F3B; font-weight:600; box-shadow:0 3rpx 10rpx rgba(83,61,38,.07); }
.mode-option text { margin-left:5rpx; color:#C47751; }
.week-navigation { display:flex; align-items:center; justify-content:space-between; margin-top:24rpx; color:#65594D; font-size:20rpx; }
.week-strip { width:100%; margin-top:18rpx; white-space:nowrap; }
.week-days { display:flex; justify-content:space-between; gap:9rpx; padding:2rpx 0 6rpx; }
.week-day { position:relative; flex:1; min-width:69rpx; height:93rpx; box-sizing:border-box; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:7rpx; border:1rpx solid #EEE5D8; border-radius:19rpx; background:#FFFDF9; color:#9B8B7B; }
.week-day-selected { border-color:#E9EDE3; background:#E9EDE3; color:#5F6B4F; }
.weekday-text { font-size:16rpx; }
.week-day-number { font-size:23rpx; font-weight:600; }
.eaten-dot { position:absolute; right:10rpx; top:9rpx; width:9rpx; height:9rpx; border-radius:50%; background:#E27B50; }
.eaten-toggle { flex-shrink:0; margin-left:8rpx; padding:9rpx 12rpx; border:1rpx solid #E9DCCB; border-radius:23rpx; color:#AD704D; font-size:16rpx; }
.eaten-toggle.is-eaten { border-color:#E6ECDF; background:#E6ECDF; color:#677454; }
.weekly-summary { display:flex; align-items:center; gap:19rpx; margin-top:24rpx; padding:20rpx 23rpx; border-radius:23rpx; background:#F2E9DC; }
.summary-number { color:#A85F3E; font-family:serif; font-size:43rpx; font-weight:700; }
.weekly-summary view { display:flex; flex-direction:column; gap:5rpx; }
.summary-title { color:#4C4238; font-size:22rpx; font-weight:600; }
.summary-caption { color:#9B8B7B; font-size:17rpx; }
.history-list { margin-top:10rpx; }
.history-day { margin-top:17rpx; padding:21rpx; border:1rpx solid #F0E8DC; border-radius:22rpx; background:#FFFDF9; }
.history-date { display:flex; justify-content:space-between; padding-bottom:14rpx; border-bottom:1rpx solid #F0E8DC; color:#4B4138; font-size:21rpx; font-weight:600; }
.history-date text:last-child { color:#A18C77; font-size:17rpx; font-weight:400; }
.history-meal { margin-top:15rpx; }
.history-meal-title { display:flex; align-items:center; gap:8rpx; margin-bottom:8rpx; color:#8C765F; font-size:18rpx; }
.history-dish { display:flex; align-items:center; padding:9rpx 0; }
.history-art { width:56rpx; height:56rpx; display:flex; align-items:center; justify-content:center; border-radius:15rpx; font-size:28rpx; }
.history-dish-info { display:flex; flex:1; flex-direction:column; gap:4rpx; margin-left:13rpx; color:#4B4138; font-size:20rpx; }
.history-dish-info text:last-child { color:#A19384; font-size:16rpx; }
.history-check { color:#73805F; font-size:22rpx; }
.history-empty { display:flex; flex-direction:column; align-items:center; gap:12rpx; margin-top:38rpx; padding:38rpx 20rpx; border:1rpx dashed #E8DED0; border-radius:24rpx; color:#8F806F; font-size:21rpx; text-align:center; }
.history-empty-icon { color:#D2BFA9; font-size:43rpx; }
.history-empty-hint { color:#A99A8C; font-size:17rpx; }
.picker-panel { display:flex; flex-direction:column; overflow:hidden; max-height:calc(100vh - env(safe-area-inset-top)); }
.picker-drag-area { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8rpx; flex-shrink:0; height:48rpx; margin-top:-13rpx; padding-bottom:10rpx; color:#B1A393; font-size:15rpx; }
.picker-drag-bar { width:70rpx; height:8rpx; border-radius:8rpx; background:#D8CCBE; }
.picker-list { flex:1; min-height:0; height:0; max-height:none; overflow-y:auto; }
.picker-recipe { gap:10rpx; }
.picker-recipe-selected { border-radius:17rpx; background:#F8F0E6; }
.picker-recipe-info { min-width:0; }
.picker-recipe-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.picker-actions { display:flex; align-items:center; gap:7rpx; flex-shrink:0; }
.picker-stepper { width:42rpx; height:42rpx; border:1rpx solid #E8DCCB; border-radius:50%; color:#A87856; text-align:center; line-height:39rpx; font-size:25rpx; }
.picker-selected-count { color:#8E7D6D; font-size:16rpx; white-space:nowrap; }
.picker-add { min-width:42rpx; height:42rpx; display:flex; align-items:center; justify-content:center; padding:0 8rpx; border-radius:23rpx; color:#C77953; font-size:24rpx; white-space:nowrap; }
.picker-recipe .picker-add:active { background:#F1E3D6; }
.dish-name { display:block; }
.dish-name text { color:#B26A46; font-size:18rpx; }

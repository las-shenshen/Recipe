.page { padding:35rpx 36rpx 150rpx; }.intro { display:flex;flex-direction:column;margin:9rpx 0 30rpx; }.eyebrow { font-size:16rpx;letter-spacing:3rpx;color:#B4A78F; }.title { font-family:serif;font-size:45rpx;font-weight:700;margin-top:13rpx; }.title text { color:#E5764A; }.subtitle { color:#918B80;font-size:22rpx;margin-top:10rpx; }.summary { display:flex;align-items:center;background:#F5EEE3;border-radius:20rpx;padding:25rpx 28rpx;margin-bottom:24rpx;position:relative; }.summary>view:first-child,.summary>view:nth-child(3) { display:flex;flex-direction:column;gap:4rpx; }.summary-num { color:#D8754C;font-family:serif;font-weight:700;font-size:40rpx; }.done-num { color:#869176; }.summary-label { color:#8C8579;font-size:19rpx; }.summary-divider { height:55rpx;width:1rpx;background:#DED5C8;margin:0 36rpx; }.basket { margin-left:auto;font-size:65rpx; }.list-card { background:#FFFDF9;border-radius:19rpx;padding:0 23rpx;box-shadow:0 8rpx 30rpx #5848270c; }.list-head { display:flex;justify-content:space-between;align-items:center;padding:23rpx 0;border-bottom:1rpx solid #F1EEE8;font-size:24rpx;font-weight:650; }.list-hint { color:#B0A99D;font-size:19rpx;font-weight:400; }.item { display:flex;align-items:center;gap:17rpx;padding:21rpx 0;border-bottom:1rpx solid #F4F1EC; }.item:last-child { border-bottom:0; }.check { width:36rpx;height:36rpx;border:2rpx solid #D9D3C9;border-radius:50%;box-sizing:border-box;color:white;text-align:center;line-height:32rpx;font-size:23rpx;flex-shrink:0; }.check.checked { border-color:#8D9A7A;background:#8D9A7A; }.item-text { display:flex;justify-content:space-between;flex:1;font-size:24rpx; }.item-amount { color:#A9A195;font-size:21rpx; }.item-text.crossed { color:#B4B0A8;text-decoration:line-through; }.crossed .item-amount { color:#C8C3BB; }.delete { width:35rpx;text-align:center;color:#C2B9AD;font-size:31rpx; }.empty { display:flex;flex-direction:column;align-items:center;background:#FFFDF9;border-radius:20rpx;padding:45rpx 25rpx;margin-bottom:23rpx; }.empty-icon { font-size:72rpx; }.empty-title { font-size:26rpx;font-weight:650;margin-top:17rpx; }.empty-desc { font-size:21rpx;color:#A29B90;margin-top:9rpx; }.browse { margin-top:20rpx;color:#D8754C;font-size:22rpx; }.add-card { background:#F3EEE5;border-radius:19rpx;padding:22rpx; }.add-title { font-size:22rpx;font-weight:650; }.add-row { display:flex;gap:10rpx;margin-top:17rpx;align-items:center; }.add-row input { background:#FFFDF9;border-radius:11rpx;padding:16rpx;font-size:21rpx;flex:1;min-width:0; }.add-row .amount-input { flex:.75; }.add-btn { width:67rpx;height:67rpx;border-radius:13rpx;background:#E5764A;color:white;text-align:center;line-height:65rpx;font-size:38rpx;flex-shrink:0; }.clear-done { text-align:center;color:#9C9387;font-size:20rpx;margin-top:23rpx; }.bottom-note { text-align:center;color:#B4ADA1;font-size:19rpx;margin-top:38rpx; }.bottom-note text { color:#DE8059; }
.mode-switch { display:flex; gap:6rpx; padding:6rpx; margin:0 0 22rpx; border-radius:17rpx; background:#F1ECE3; }
.mode { flex:1; padding:15rpx 10rpx; text-align:center; border-radius:13rpx; color:#8E7D6D; font-size:21rpx; }
.mode.selected { background:#FFFDF9; color:#C76E48; font-weight:600; box-shadow:0 3rpx 10rpx #58482710; }
.sync-status { display:flex;justify-content:space-between;align-items:center;padding:15rpx 18rpx;margin:-7rpx 0 18rpx;border-radius:10rpx;background:#EAF0E6;color:#58704F;font-size:20rpx; }
.sync-status.sync-error { background:#F8E9E5;color:#A94E3D; }
.legacy-import { display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:19rpx 20rpx;margin:0 0 20rpx;border:1rpx solid #E7D8C6;border-radius:12rpx;background:#FFFBF4; }
.legacy-copy { display:flex;flex-direction:column;gap:6rpx;min-width:0; }
.legacy-title { font-size:22rpx;font-weight:650; }
.legacy-detail { color:#968B7D;font-size:18rpx; }
.legacy-button { flex:none;margin:0;padding:0 17rpx;height:58rpx;line-height:58rpx;border:0;border-radius:9rpx;background:#E5764A;color:#fff;font-size:19rpx; }
.legacy-button[disabled] { background:#B9B1A5;color:#fff; }
.list-head { display:flex; justify-content:space-between; align-items:center; margin:15rpx 3rpx; font-size:23rpx; font-weight:650; }
.list-hint { color:#A79D90; font-size:19rpx; font-weight:400; }
.groups { display:flex; flex-direction:column; gap:18rpx; }
.recipe-group { padding:0 22rpx; border-radius:19rpx; background:#FFFDF9; box-shadow:0 7rpx 24rpx #493a1b0b; }
.group-title { display:flex; justify-content:space-between; align-items:center; padding:21rpx 0 17rpx; border-bottom:1rpx solid #F1EEE8; }
.group-title>view { display:flex; flex-direction:column; gap:6rpx; }
.group-name { font-size:24rpx; font-weight:650; }
.group-meta { color:#A1988B; font-size:18rpx; }
.list-card .item { flex-wrap:wrap; }
.check.partial { border-color:#D5A274; background:#F6EBDD; color:#B8754D; }
.source-note { width:100%; box-sizing:border-box; padding-left:53rpx; margin-top:-8rpx; color:#9B9185; font-size:18rpx; line-height:1.5; }

.page { min-height:100vh; box-sizing:border-box; padding:32rpx 32rpx calc(var(--tabbar-space) + 48rpx); }
.intro { display:flex; flex-direction:column; margin-bottom:32rpx; }
.title { margin-top:8rpx; font-family:var(--serif); font-size:48rpx; line-height:1.3; font-weight:700; }
.title text { color:var(--accent); }
.subtitle { margin-top:8rpx; color:var(--ink-3); font-size:26rpx; }

/* 同步状态与旧清单导入 */
.sync-status { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-bottom:24rpx; padding:20rpx 24rpx; border-radius:20rpx; background:var(--green-soft); color:var(--green); font-size:24rpx; }
.sync-status.sync-error { background:#FBE9E3; color:#A5472F; }
.legacy-import { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin-bottom:24rpx; padding:24rpx; border:1rpx solid #EBD9C3; border-radius:24rpx; background:#FFF8EE; }
.legacy-copy { min-width:0; display:flex; flex-direction:column; gap:6rpx; }
.legacy-title { font-size:28rpx; font-weight:600; }
.legacy-detail { color:var(--ink-3); font-size:24rpx; }
.legacy-button { flex:none; width:auto !important; min-width:0; height:68rpx; margin:0; padding:0 28rpx; border-radius:999rpx; background:var(--accent); color:#FFF; font-size:26rpx; font-weight:600; line-height:68rpx; }
.legacy-button[disabled] { background:var(--ink-4) !important; color:#FFF !important; }

/* 进度概览 */
.summary { display:flex; align-items:center; margin-bottom:28rpx; padding:32rpx; border-radius:var(--radius-card); background:linear-gradient(135deg,#F9EFE0,#F3E3CE); }
.summary-cell { display:flex; flex-direction:column; gap:2rpx; min-width:112rpx; }
.summary-num { color:var(--accent); font-family:var(--serif); font-size:56rpx; line-height:1.15; font-weight:700; }
.done-num { color:var(--green-solid); }
.summary-label { color:var(--ink-2); font-size:24rpx; }
.summary-divider { width:1rpx; height:72rpx; margin:0 40rpx; background:#E2D5C3; }
.basket { margin-left:auto; font-size:88rpx; line-height:1; }

/* 分段切换 */
.mode-switch { display:flex; gap:8rpx; margin-bottom:32rpx; padding:8rpx; border-radius:var(--radius-control); background:var(--fill); }
.mode { flex:1; padding:16rpx 8rpx; border-radius:18rpx; color:var(--ink-3); text-align:center; font-size:26rpx; }
.mode.selected { background:var(--card); color:var(--accent-deep); font-weight:600; box-shadow:0 4rpx 12rpx rgba(92,68,40,.08); }

/* 清单 */
.list-head { display:flex; align-items:baseline; justify-content:space-between; margin:0 4rpx 20rpx; font-size:30rpx; font-weight:600; }
.list-hint { color:var(--ink-3); font-size:24rpx; font-weight:400; }
.groups { display:flex; flex-direction:column; gap:20rpx; }
.recipe-group, .list-card { padding:0 24rpx; border:1rpx solid var(--line); border-radius:28rpx; background:var(--card); box-shadow:var(--shadow-card); }
.group-title { display:flex; flex-direction:column; gap:4rpx; padding:24rpx 0 20rpx; border-bottom:1rpx solid var(--line); }
.group-name { font-size:30rpx; font-weight:600; }
.group-meta { color:var(--ink-3); font-size:24rpx; }
.item { display:flex; align-items:center; border-bottom:1rpx solid var(--line); }
.item:last-child { border-bottom:0; }
.item-main { flex:1; min-width:0; display:flex; align-items:center; gap:20rpx; padding:24rpx 0; }
.check { position:relative; flex:none; width:44rpx; height:44rpx; box-sizing:border-box; border:3rpx solid #D5CCBE; border-radius:50%; }
.check.checked { border-color:var(--green-solid); background:var(--green-solid); }
.check.checked::after { content:""; position:absolute; left:12rpx; top:5rpx; width:10rpx; height:18rpx; border-right:4rpx solid #FFF; border-bottom:4rpx solid #FFF; transform:rotate(45deg); }
.check.partial { border-color:#D9A46F; background:#FBF1E4; }
.check.partial::after { content:""; position:absolute; left:9rpx; right:9rpx; top:50%; height:4rpx; margin-top:-2rpx; border-radius:4rpx; background:var(--accent-deep); }
.item-body { flex:1; min-width:0; display:flex; flex-direction:column; gap:4rpx; }
.item-text { display:flex; align-items:baseline; justify-content:space-between; gap:20rpx; font-size:30rpx; }
.item-name { min-width:0; }
.item-amount { flex:none; color:var(--ink-3); font-size:26rpx; }
.item-text.crossed { color:var(--ink-4); text-decoration:line-through; }
.crossed .item-amount { color:var(--ink-4); }
.source-note { color:var(--ink-3); font-size:22rpx; line-height:1.5; }
.delete { flex:none; width:72rpx; height:72rpx; margin-right:-16rpx; text-align:center; line-height:68rpx; color:var(--ink-4); font-size:40rpx; }

.empty { display:flex; flex-direction:column; align-items:center; padding:56rpx 32rpx; border:2rpx dashed var(--line); border-radius:28rpx; }
.empty-icon { font-size:88rpx; line-height:1.2; }
.empty-title { margin-top:16rpx; font-size:32rpx; font-weight:600; }
.empty-desc { margin-top:8rpx; color:var(--ink-3); font-size:26rpx; }
.browse { margin-top:20rpx; padding:12rpx 24rpx; color:var(--accent); font-size:28rpx; font-weight:600; }

/* 手动添加 */
.add-card { margin-top:28rpx; padding:28rpx; border-radius:28rpx; background:var(--fill); }
.add-title { font-size:28rpx; font-weight:600; }
.add-row { display:flex; align-items:center; gap:12rpx; margin-top:20rpx; }
.add-row input { flex:1; min-width:0; height:80rpx; padding:0 24rpx; box-sizing:border-box; border-radius:18rpx; background:var(--card); font-size:28rpx; }
.add-row .amount-input { flex:.7; }
.add-btn { flex:none; width:80rpx; height:80rpx; border-radius:18rpx; background:var(--accent); color:#FFF; text-align:center; line-height:76rpx; font-size:44rpx; }

.clear-done { margin-top:28rpx; padding:20rpx; border:2rpx solid var(--line); border-radius:999rpx; color:var(--ink-2); text-align:center; font-size:26rpx; }
.bottom-note { margin-top:48rpx; color:var(--ink-3); font-size:24rpx; text-align:center; }

<view class="page"><view class="intro"><text class="eyebrow">A LITTLE NOTE FOR THE MARKET</text><text class="title">采购清单<text>。</text></text><text class="subtitle">多人共享，勾选进度自动同步。</text></view>
  <view wx:if="{{syncing || pendingCount || syncError}}" class="sync-status {{syncError ? 'sync-error' : ''}}" bindtap="retrySync"><text>{{syncError ? '同步暂不可用，点此重试' : pendingCount ? pendingCount + ' 项待同步 · 联网后自动更新' : '正在同步共享清单'}}</text><text wx:if="{{!syncing && syncError}}">重试 ›</text></view>
  <view wx:if="{{legacyCount}}" class="legacy-import"><view class="legacy-copy"><text class="legacy-title">发现本机旧清单</text><text class="legacy-detail">{{legacyCount}} 项尚未共享，原清单会保留</text></view><button class="legacy-button" disabled="{{importPending}}" bindtap="importLegacy">{{importPending ? '等待同步' : '预览并共享'}}</button></view>
  <view class="summary"><view><text class="summary-num">{{remainingCount}}</text><text class="summary-label">还要买</text></view><view class="summary-divider"></view><view><text class="summary-num done-num">{{checkedCount}}</text><text class="summary-label">已买好</text></view><view class="basket">🧺</view></view>
  <view class="mode-switch"><view class="mode {{activeView === 'recipe' ? 'selected' : ''}}" data-view="recipe" bindtap="switchView">按菜谱</view><view class="mode {{activeView === 'ingredient' ? 'selected' : ''}}" data-view="ingredient" bindtap="switchView">按食材</view></view>
  <view class="list-head" wx:if="{{items.length}}"><text>{{activeView === 'recipe' ? '按菜谱分类汇总' : '相同食材已合并'}}</text><text class="list-hint">{{displayCount}} 项</text></view>
  <view wx:if="{{items.length && activeView === 'recipe'}}" class="groups"><view class="recipe-group" wx:for="{{recipeGroups}}" wx:key="key"><view class="group-title"><view><text class="group-name">{{item.name}}</text><text class="group-meta">{{item.category}} · {{item.items.length}} 种食材</text></view></view><view class="item" wx:for="{{item.items}}" wx:for-item="food" wx:key="id"><view class="check {{food.checked ? 'checked' : ''}}" data-id="{{food.id}}" bindtap="toggleItem">{{food.checked ? '✓' : ''}}</view><view class="item-text {{food.checked ? 'crossed' : ''}}"><text>{{food.name}}</text><text class="item-amount">{{food.amount}}</text></view><text class="delete" data-id="{{food.id}}" bindtap="deleteItem">×</text></view></view></view>
  <view wx:if="{{items.length && activeView === 'ingredient'}}" class="list-card"><view class="item" wx:for="{{ingredientGroups}}" wx:key="key"><view class="check {{item.checked ? 'checked' : ''}} {{item.partial ? 'partial' : ''}}" data-key="{{item.key}}" bindtap="toggleIngredient">{{item.checked ? '✓' : item.partial ? '−' : ''}}</view><view class="item-text {{item.checked ? 'crossed' : ''}}"><text>{{item.name}}</text><text class="item-amount">{{item.amount}}</text></view><text class="delete" data-key="{{item.key}}" bindtap="deleteIngredient">×</text><text wx:if="{{item.note}}" class="source-note">{{item.note}}</text></view></view>
  <view class="empty" wx:if="{{!items.length}}"><text class="empty-icon">🧺</text><text class="empty-title">清单还是空的</text><text class="empty-desc">从菜谱或今日点菜加入食材。</text><navigator class="browse" open-type="switchTab" url="/pages/recipes/recipes">去挑几道菜 →</navigator></view>
  <view class="add-card"><text class="add-title">临时想起要买什么？</text><view class="add-row"><input placeholder="食材名称" value="{{newName}}" bindinput="onNameInput" confirm-type="done"/><input class="amount-input" placeholder="用量" value="{{newAmount}}" bindinput="onAmountInput" confirm-type="done"/><view class="add-btn" bindtap="addItem">＋</view></view></view>
  <view wx:if="{{checkedCount}}" class="clear-done" bindtap="clearChecked">清除已买好的 {{checkedCount}} 项</view><view class="bottom-note">买得刚刚好，吃得也刚刚好 <text>✳</text></view>
</view>

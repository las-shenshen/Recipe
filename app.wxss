/* 全局设计变量：各页面统一从这里取色，不再各写各的近似色 */
page {
  --paper: #FFFCF7;        /* 页面底色 */
  --card: #FFFFFF;         /* 卡片底色 */
  --fill: #F6F0E7;         /* 输入框、分段控件等浅底 */
  --line: #EFE7DB;         /* 分隔线、描边 */
  --ink: #2B2824;          /* 主文字 */
  --ink-2: #665D53;        /* 次要文字 */
  --ink-3: #8A7E72;        /* 说明文字 */
  --ink-4: #B3A899;        /* 占位符、装饰 */
  --accent: #E06C3E;       /* 主色：陶土橙 */
  --accent-deep: #B4582F;  /* 浅橙底上的文字 */
  --accent-soft: #FBEDE3;  /* 浅橙底 */
  --green: #5F7150;        /* 浅绿底上的文字 */
  --green-solid: #7F9069;  /* 已完成 */
  --green-soft: #E9EFE2;   /* 浅绿底 */
  --sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  --serif: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", serif; /* 标题用衬线体 */
  --radius-card: 32rpx;
  --radius-control: 24rpx;
  --shadow-card: 0 8rpx 32rpx rgba(92, 68, 40, .06);
  /* 自定义底部导航的高度（含安全区），带导航的页面用它留出底部空间 */
  --tabbar-space: calc(112rpx + env(safe-area-inset-bottom));

  background: var(--paper);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

button { box-sizing: border-box; }
button::after { border: 0; }
.input-placeholder, .textarea-placeholder { color: var(--ink-4); }

/* 页面顶部的英文小标 */
.eyebrow { color: var(--ink-3); font-size: 22rpx; letter-spacing: 4rpx; }

/* 用 CSS 画的图标，避免特殊字符在部分机型上显示成方框 */
.icon-search { position: relative; flex: none; width: 28rpx; height: 28rpx; margin-right: 8rpx; box-sizing: border-box; border: 4rpx solid currentColor; border-radius: 50%; }
.icon-search::after { content: ""; position: absolute; right: -10rpx; bottom: -8rpx; width: 4rpx; height: 14rpx; border-radius: 4rpx; background: currentColor; transform: rotate(-45deg); }
.icon-chevron-down { flex: none; width: 14rpx; height: 14rpx; margin: -8rpx 6rpx 0; box-sizing: border-box; border-right: 4rpx solid currentColor; border-bottom: 4rpx solid currentColor; transform: rotate(45deg); }
